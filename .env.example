# ---------------------------------------------------------------------------
# Inktoll environment
# Copy to .env at the repo root. Defaults (when a var is omitted) target
# Arc TESTNET, so an existing deployment keeps working unchanged.
# ---------------------------------------------------------------------------

PORT=3001
AGENT_PORT=3002
DATABASE_PATH=./data/inktoll.db

# Public origin of the backend API — advertised to agents in the x402
# challenge. REQUIRED on mainnet (must not be localhost).
PUBLIC_API_URL=https://api.inktoll.xyz
NEXT_PUBLIC_API_URL=https://api.inktoll.xyz

# Shared secret for trusted server-to-server reads (agent service -> backend),
# used to serve content an agent has already paid for. REQUIRED on mainnet.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# --- AI ---
OPENAI_API_KEY=

# --- Circle ---
# Use your LIVE keys for mainnet and TEST keys for testnet; they are not
# interchangeable, and each environment needs its own registered entity
# secret and wallet set.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_TREASURY_ADDRESS=

# ---------------------------------------------------------------------------
# Arc TESTNET (current default)
# ---------------------------------------------------------------------------
ARC_CHAIN_ID=5042002
ARC_BLOCKCHAIN_NAME=ARC-TESTNET
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_VERIFYING_CONTRACT=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
CIRCLE_GATEWAY_URL=https://gateway-api-testnet.circle.com
ARC_EXPLORER_URL=https://testnet.arcscan.app
NEXT_PUBLIC_EXPLORER_URL=https://testnet.arcscan.app
# Testnet-only: funds the agent faucet. No faucet exists on mainnet.
FAUCET_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Arc MAINNET — swap the block above for these values to go live.
# Setting ARC_CHAIN_ID=5042 (or ARC_BLOCKCHAIN_NAME=ARC) flips the whole app
# into mainnet mode: faucets are disabled and mainnet guards are enforced.
# ---------------------------------------------------------------------------
# ARC_CHAIN_ID=5042
# ARC_BLOCKCHAIN_NAME=ARC
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# ARC_VERIFYING_CONTRACT=0x77777777Dcc4d5A8B6E418Fd04D8997ef11000eE
# CIRCLE_GATEWAY_URL=https://gateway-api.circle.com
# ARC_EXPLORER_URL=https://explorer.arc.io
# NEXT_PUBLIC_EXPLORER_URL=https://explorer.arc.io
# Circle domain id for Arc is 26 on both networks (override only if it changes)
# ARC_GATEWAY_DOMAIN=26
